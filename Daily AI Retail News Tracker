name: Daily AI Retail News Tracker

on:
  schedule:
    - cron: '0 9 * * *'
  workflow_dispatch:

jobs:
  fetch-news:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          token: ${{ secrets.PAT_TOKEN }}
          persist-credentials: true

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run news tracker
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
          SMTP_SERVER: ${{ secrets.SMTP_SERVER }}
          SMTP_PORT: ${{ secrets.SMTP_PORT }}
          SMTP_USER: ${{ secrets.SMTP_USER }}
          SMTP_PASSWORD: ${{ secrets.SMTP_PASSWORD }}
        run: python daily_news.py

      - name: Commit and push updated files
        run: |
          git config user.name "AI News Bot"
          git config user.email "bot@valueretail.com"
          git add AI_Retail_News_Log.csv LATEST_ANALYSIS.md daily_analysis_*.md
          if git diff --cached --quiet; then
            echo "No new articles found today."
          else
            git commit -m "📰 Daily AI retail news update - $(date +'%Y-%m-%d')"
            git push https://x-access-token:${{ secrets.PAT_TOKEN }}@github.com/aditbanta/ai-retail-news-tracker.git main
          fi
