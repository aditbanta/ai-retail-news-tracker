name: Daily AI Retail News Tracker

on:
  schedule:
    - cron: '0 9 * * *'
  workflow_dispatch:

permissions:
  contents: write

jobs:
  fetch-news:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          persist-credentials: true
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install -r requirements.txt

      - name: Run news tracker
        env:
          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
        run: python daily_news.py

      - name: Commit and push updated CSV
        run: |
          git config user.name "AI News Bot"
          git config user.email "bot@valueretail.com"
          git remote set-url origin https://x-access-token:${{ secrets.GITHUB_TOKEN }}@github.com/aditbanta/ai-retail-news-tracker.git
          git add AI_Retail_News_Log.csv
          git diff --cached --quiet || git commit -m "📰 Daily AI retail news update - $(date +'%Y-%m-%d')"
          git push
